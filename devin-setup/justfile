set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

# List recipes
default:
    @just --list

# Install numbered modules (args pass through: just setup --member ivan)
[unix]
setup *args:
    ./setup {{args}}

[windows]
setup *args:
    powershell -NoProfile -ExecutionPolicy Bypass -File ./setup.ps1 {{args}}

# Planned work, no downloads
[unix]
dry-run:
    ./setup --dry-run

[windows]
dry-run:
    powershell -NoProfile -ExecutionPolicy Bypass -File ./setup.ps1 --dry-run

# Check without installing
[unix]
status:
    ./setup --status

[windows]
status:
    powershell -NoProfile -ExecutionPolicy Bypass -File ./setup.ps1 --status

# Proof: pin == config == generated stack-pin copy
[unix]
check:
    python3 scripts/check_devin_setup.py

[windows]
check:
    python scripts/check_devin_setup.py

# Repair safe drift (managed user config, .agent dirs), then re-check
[unix]
repair:
    python3 scripts/repair_devin_setup.py

[windows]
repair:
    python scripts/repair_devin_setup.py

# Sync build/stack-pin.json from ../build/stack-pin.json (generated file)
[unix]
sync-pin:
    python3 scripts/sync_stack_pin.py

[windows]
sync-pin:
    python scripts/sync_stack_pin.py

# Ready gate: status + checker + pinned binaries
[unix]
gate:
    ./setup --status
    python3 scripts/check_devin_setup.py
    devin --version
    herdr --version

[windows]
gate:
    powershell -NoProfile -ExecutionPolicy Bypass -File ./setup.ps1 --status
    python scripts/check_devin_setup.py
    devin --version
    herdr --version

# Repo tests
test:
    pytest -q tests/
