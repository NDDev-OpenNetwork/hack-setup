{
  // Projection of devin-pin.json mcp_servers — same six servers as the
  // codex setup. Secrets are ${VAR} references, never literals.
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": ["--from", "serena-agent==1.7.0", "serena", "start-mcp-server", "--context", "codex", "--open-web-dashboard", "false"]
    },
    "shadcn": {
      "command": "bunx",
      "args": ["shadcn@4.21.0", "mcp"]
    },
    "context7": { "url": "https://mcp.context7.com/mcp" },
    "grep": { "url": "https://mcp.grep.app" },
    "deepwiki": { "url": "https://mcp.deepwiki.com/mcp" },
    "keenable": {
      "url": "https://api.keenable.ai/mcp",
      "headers": { "X-API-Key": "${KEENABLE_API_KEY}" }
    }
  }
}
