{
  "schema_version": 2,
  "verified_on": "2026-09-20",
  "reverify_on_hackathon": true,
  "policy": "latest-compatible-stable; freeze after prep; hackathon bumps are explicit",
  "codex_pin": "build/codex-pin.json",
  "package_manager": "bun",
  "locales": ["ru", "kk", "en"],
  "do_not_use": [
    "pnpm",
    "npm as the project installer",
    "Next.js",
    "openapi-typescript as the primary generator",
    "React Three Fiber / @react-three/drei",
    "LangChain / LlamaIndex as required orchestration",
    "Elasticsearch / pgvector",
    "pasync as a PostgreSQL driver",
    "independent Dart upgrades outside Flutter",
    "Tauri 3 alpha",
    "Node.js 26 Current",
    "openai Python SDK 3.x in the API env",
    "LiteLLM proxy-runtime extra in the API env",
    "opencv-python together with opencv-python-headless",
    "second JS lockfile",
    "0.156.0-alpha",
    "Codex.app",
    "gpt-6-astra until Codex CLI pin changes"
  ],
  "environments": {
    "api_workers": {
      "python": "3.14.7",
      "redis_py": "8.1.0",
      "shares": "FastAPI API and Taskiq workers may share this env"
    },
    "telegram": {
      "python": "3.14.7",
      "redis_py": "7.4.1",
      "reason": "aiogram[redis] requires redis<8; isolate from taskiq-redis >=8"
    },
    "gpu_ml": {
      "isolates": ["faster-whisper", "CTranslate2", "PyTorch", "ONNX Runtime", "FastEmbed"]
    },
    "litellm_proxy": {
      "isolates": "optional full proxy-runtime container with its own OTel 1.28.0 pins"
    }
  },
  "registered": {
    "marketplace": {
      "name": "saint-tibo",
      "path": ".agents/plugins/marketplace.json",
      "cli": "codex plugin marketplace add .",
      "status": "in-repo; not yet added to this machine's Codex marketplace list"
    },
    "plugin": {
      "id": "saint-tibo@saint-tibo",
      "path": "plugins/saint-tibo/plugin.json",
      "policy": "INSTALLED_BY_DEFAULT",
      "enabled_in": ".codex/config.toml",
      "cli": "codex plugin add saint-tibo@saint-tibo",
      "status": "enabled in project config after trust; plugin add not run by ./setup"
    },
    "agents": ["mapper", "reviewer", "implementer"],
    "repo_skills": ["repo-orientation", "quality-gate", "one-repo-workflow"],
    "plugin_skills": ["saint-tibo"],
    "features": {
      "multi_agent": true,
      "hooks": true,
      "memories": false,
      "web_search": "cached"
    }
  },
  "models": {
    "default": "gpt-5.6",
    "alias_of": "gpt-5.6-sol",
    "mapper": "gpt-5.6-luna",
    "reviewer": "gpt-5.6-terra",
    "implementer": "gpt-5.6",
    "source": "https://developers.openai.com/api/docs/models"
  },
