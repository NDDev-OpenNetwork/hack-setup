{
  "schema_version": 2,
  "verified_on": "2026-09-20",
  "reverify_on_hackathon": true,
  "policy": "latest-compatible-stable; freeze after prep; hackathon bumps are explicit",
  "codex_pin": "build/codex-pin.json",
  "control": {
    "law": ["build/codex-pin.json", "build/stack-pin.json"],
    "runtime": ".codex/config.toml",
    "generated": "build/stack-standard.md",
    "router": "AGENTS.md",
    "rules": "plugins/hack-agent-standards/standards/INDEX.md",
    "proof": "just check",
    "gate": "just gate"
  },
  "package_manager": "bun",
  "locales": ["ru", "kk", "en"],
  "do_not_use": [
    "pnpm",
    "npm as the project installer",
    "Next.js",
    "openapi-typescript as the primary generator",
    "React Three Fiber / @react-three/drei",
    "LangChain / LlamaIndex as required orchestration",
    "Elasticsearch / pgvector",
    "asyncpg as a PostgreSQL driver",
    "independent Dart upgrades outside Flutter",
    "Tauri 3 alpha",
    "Node.js 26 Current",
    "openai Python SDK 3.x in the API env",
    "LiteLLM proxy-runtime extra in the API env",
    "opencv-python together with opencv-python-headless",
    "second JS lockfile",
    "typescript@6 or @typescript/typescript6 in the web workspace",
    "typescript-eslint in the web workspace",
    "@hey-api/openapi-ts@next",
    "bun add shadcn (nests zod 3); use bunx shadcn@4.21.0",
    "@types/node 26.x until Node 26 is LTS",
    "unconstrained rapidocr / opencv-python; pin is opencv-python-headless 5.0.0.93",
    "httpx 1.x; FastAPI extras require httpx<1",
    "GNU make / Makefile as the project command runner",
    "0.156.0-alpha",
    "Codex.app",
    "gpt-5.6-luna",
    "gpt-5.6-terra",
    "gpt-5.6 as a Codex session slug (not a catalog slug; use gpt-5.6-sol)",
    "Codex subagents / features.multi_agent / features.multi_agent_v2",
    "model_reasoning_effort extra-high or x-high (wire value is xhigh)"
  ],
  "environments": {
    "api_workers": {
      "python": "3.14.7",
      "redis_py": "8.1.0",
      "shares": "FastAPI API and Taskiq workers may share this env"
    },
    "telegram": {
      "python": "3.14.7",
      "redis_py": "7.4.1",
      "reason": "aiogram[redis] 3.31.0 requires redis[hiredis]<8,>=6.2.0; taskiq-redis 1.2.3 requires redis>=8,<9"
    },
    "gpu_ml": {
      "isolates": ["faster-whisper", "CTranslate2", "PyTorch", "ONNX Runtime", "FastEmbed"]
    },
    "litellm_proxy": {
      "isolates": "optional full proxy-runtime container with its own OTel 1.28.0 pins"
    }
  },
  "registered": {
    "marketplace": {
      "name": "saint-tibo",
      "path": ".agents/plugins/marketplace.json",
      "cli": "codex plugin marketplace add .",
      "status": "in-repo; ./setup does not run marketplace add"
    },
    "plugin": {
      "id": "saint-tibo@saint-tibo",
      "path": "plugins/saint-tibo/plugin.json",
      "policy": "INSTALLED_BY_DEFAULT",
      "enabled_in": ".codex/config.toml",
      "cli": "codex plugin add saint-tibo@saint-tibo",
      "status": "enabled in project config after trust; plugin add not run by ./setup"
    },
    "standards_plugin": {
      "id": "hack-agent-standards@saint-tibo",
      "path": "plugins/hack-agent-standards/plugin.json",
      "standards": "plugins/hack-agent-standards/standards/INDEX.md",
      "policy": "INSTALLED_BY_DEFAULT",
      "enabled_in": ".codex/config.toml",
      "status": "first setup component; frames live in the plugin"
    },
    "agents": [],
    "agents_enabled": false,
    "repo_skills": [
      "repo-orientation",
      "quality-gate",
      "one-repo-workflow",
      "apply-stack-rule"
    ],
    "plugin_skills": ["saint-tibo"],
    "standards_plugin_skills": [
      "apply-agent-standard",
      "core-motion",
      "quality-proof",
      "pin-dependencies",
      "web-ui",
      "python-api",
      "wire-contracts",
      "data-stores",
      "native-clients",
      "ai-models",
      "identity-auth",
      "text-formats",
      "file-documents",
      "education-lessons",
      "runtime-infra"
    ],
    "features": {
      "multi_agent": false,
      "multi_agent_v2": false,
      "hooks": true,
      "memories": false,
      "web_search": "live"
    },
    "session": {
      "approval_policy": "never",
      "sandbox_mode": "danger-full-access",
      "allow_login_shell": true,
      "web_search": "live",
      "permission_system": "sandbox_mode",
      "cli_equivalent": "--dangerously-bypass-approvals-and-sandbox",
      "cli_alias": "--yolo",
      "not_yolo": "--full-auto",
      "project_execpolicy_rules": false,
      "ignore_rules_is_config_key": false,
      "ignore_rules_cli": "codex exec --ignore-rules"
    }
  },
  "models": {
    "primary": "gpt-6-astra",
    "secondary": "gpt-5.6-sol",
    "secondary_profile": "sol",
    "review_model": "gpt-5.6-sol",
    "reasoning_effort": "xhigh",
    "reject": [
      "gpt-5.6-luna",
      "gpt-5.6-terra",
      "gpt-5.6",
      "gpt-6",
      "extra-high",
      "x-high",
      "extra_high"
