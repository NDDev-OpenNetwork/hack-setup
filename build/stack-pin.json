  "conflicts": [
    {
      "id": "ts7-compiler-api",
      "decision": "TS7 is the typechecker; @typescript/typescript6 only for tools that still need the JS compiler API"
    },
    {
      "id": "openapi-typescript-ts5",
      "decision": "Hey API @hey-api/openapi-ts 0.99.0; do not force openapi-typescript onto TS7"
    },
    {
      "id": "aiogram-redis-vs-taskiq",
      "decision": "API/worker redis-py 8.1.0; Telegram env redis-py 7.4.1; one Redis server 8.10.2"
    },
    {
      "id": "litellm-otel",
      "decision": "API uses LiteLLM SDK only; proxy-runtime stays in its own container"
    },
    {
      "id": "r3f-react-19-3",
      "decision": "direct three 0.186.0; no R3F/Drei"
    },
    {
      "id": "flutter-dart",
      "decision": "pin Flutter 3.47.5 and its bundled Dart 3.13.4"
    },
    {
      "id": "openai-sdk-major",
      "decision": "API env openai 2.9.0 because litellm 1.101.0 is openai<3"
    }
  ],
