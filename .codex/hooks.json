{
  "description": "hack-mode lifecycle: ruleset at session start (all sources incl. fork/compact), reminder + git/issues STATUS per prompt, lane-law push guard (PreToolUse), ship-verify nudge after git push (PostToolUse), session log on exit/interrupt (SessionEnd/Interrupt). Law: build/stack-pin.json registered.hooks.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/hack_mode.py session",
            "commandWindows": "python .codex/hooks/hack_mode.py session",
            "timeout": 5,
            "statusMessage": "Loading hack mode",
            "additionalContextLimit": 12000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/hack_mode.py prompt",
            "commandWindows": "python .codex/hooks/hack_mode.py prompt",
            "timeout": 5,
            "statusMessage": "hack mode"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command|write_stdin|shell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/hack_mode.py pretooluse",
            "commandWindows": "python .codex/hooks/hack_mode.py pretooluse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|exec_command|write_stdin|shell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/hack_mode.py posttooluse",
            "commandWindows": "python .codex/hooks/hack_mode.py posttooluse",
            "timeout": 5
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/hack_mode.py interrupt",
            "commandWindows": "python .codex/hooks/hack_mode.py interrupt",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/hack_mode.py sessionend",
            "commandWindows": "python .codex/hooks/hack_mode.py sessionend",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
